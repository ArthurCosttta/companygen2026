      "anchors": [
        "src/utils/chunk-recovery.ts#lazyNamed"
      ],
      "test": "tests/unit/onda1-foundation.test.mjs"
    },
    {
      "id": "INV-PHARMA-CATALOG-WINS",
      "intent": "BEHAVIOR",
      "rule": "Classificação determinística por catálogo real prevalece sobre rótulo genérico ou sugestão LLM",
      "anchors": [
        "shared/formula-ir/spreadsheet-intelligence.mjs#classifyBusinessArchetype",
        "src/components/views/onboarding/OnboardingIgnitionView.tsx#OnboardingIgnitionView"
      ],
      "test": "tests/xlsx-benchmark-v2.test.mjs"
    },
    {
      "id": "INV-TELEMETRY-PII-MASKED",
      "intent": "OBSERVABILITY",
      "rule": "Telemetria de crash deve mascarar PII e correlacionar arquivos suspeitos antes de persistir",
      "anchors": [
        "server/crash-telemetry.mjs#inferSuspectedFilesAndCause"
      ],
      "test": "tests/unit/crash-telemetry.test.mjs"
