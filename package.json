{
  "name": "companygen-post-studio",
  "private": true,
  "version": "1.1.0",
  "description": "CompanyGen Desktop — Vitrine com IA e Atendimento Automático Sofia no WhatsApp",
  "author": "CompanyGen",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "node scripts/run-sandbox.mjs",
    "desktop": "electron desktop/main.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:unit": "node --test tests/formula-v9-composer.test.mjs tests/xlsx-universal.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:security": "node --test tests/security-api.test.mjs",
    "eval:ai": "node scripts/eval-ai-suite.mjs",
    "backup:321": "node scripts/backup-321.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win-dir": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "store.companygen.desktop",
    "productName": "CompanyGen",
    "copyright": "Copyright © 2026 CompanyGen",
    "asar": true,
    "asarUnpack": [
      "server/**",
      "dist/**",
      "shared/**",
      "src/config/**"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/slim-electron-locales.mjs",
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "src/config/supabase-public.json",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/tests/**",
      "!**/__tests__/**",
      "!release/**"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "shared",
        "to": "shared"
      },
      {
        "from": "src/config",
        "to": "src/config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/brand/app-icon-512.png",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "compression": "maximum",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
