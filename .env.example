# ==============================================================================
# CompanyGen — Variáveis de Ambiente de Produção (Cloud Run / Painel do Servidor)
# IMPORTANTE: NUNCA commitar o arquivo .env real no GitHub nem enviar ao Firebase Hosting!
# Preencha estes valores diretamente nas Variáveis de Ambiente do serviço "companygen-app" no Cloud Run.
# ==============================================================================

# --- Servidor & URL Pública ---
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
COMPANYGEN_URL=https://companygen.store
CG_ADMIN_EMAILS=arthurpolarbuy@gmail.com

# --- Supabase (Painel Supabase > Project Settings > API) ---
# Nota: VITE_SUPABASE_URL e VITE_SUPABASE_PUBLISHABLE_KEY já têm fallback em src/config/supabase-public.json
CG_SUPABASE_URL=https://irahjajgudbdkgggffum.supabase.co
CG_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Motor de Texto GLM-5.3 ---
GLM_API_KEY=
GLM_ENDPOINT_URL=
GLM_MODEL=zai-org/GLM-5.3
GLM_TIMEOUT_MS=25000

# --- Motor de Imagens RunPod ---
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
IMAGE_PROVIDER=runpod
IMAGE_MODEL=
IMAGE_ENDPOINT_URL=
IMAGE_HERO_MODEL=
IMAGE_HERO_ENDPOINT_URL=
IMAGE_EDIT_MODEL=
IMAGE_EDIT_ENDPOINT_URL=

# --- Segurança, Webhooks & Backup 3-2-1 ---
CG_BACKUP_PASSPHRASE=
CG_SHOWCASE_HMAC_SECRET=
CG_PAYMENT_WEBHOOK_SECRET=

# --- Áudio STT Nuvem (Opcional) ---
WHISPER_ENDPOINT_URL=
WHISPER_API_KEY=

# --- E-mail Transacional Gmail SMTP (Notificações de Créditos e Digest Admin) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CompanyGen <noreply@companygen.store>"

# --- Lembrete: Segredos no Painel do Supabase (não vão no Cloud Run) ---
# 1. SMTP Gmail (Supabase Auth > SMTP Settings): host smtp.gmail.com, porta 465/587, usuário suporte@companygen.store + App Password Gmail
# 2. Edge Function kiwify-webhook: KIWIFY_WEBHOOK_SECRET, APP_URL=https://companygen.store
