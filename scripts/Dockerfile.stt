# Microserviço Python STT separado (Cloud Run: companygen-stt)
FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY scripts/requirements-stt.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY scripts/transcribe_audio.py ./transcribe_audio.py
ENV PORT=8080
ENV STT_MODEL=small
ENV STT_COMPUTE_TYPE=int8
EXPOSE 8080
CMD ["python", "transcribe_audio.py", "--serve", "--host", "0.0.0.0", "--port", "8080"]
