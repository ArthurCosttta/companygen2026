{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof.local/schemas/site-v3.json",
  "title": "SOF Genome Studio V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "business",
    "theme",
    "whatsapp",
    "categories",
    "products",
    "assets",
    "layout",
    "messages",
    "rules",
    "prompts"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "business": {
      "type": "object",
      "required": [
        "name",
        "description",
        "address"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "address": {
          "type": "object",
          "required": [
            "city",
            "state"
          ],
          "properties": {
            "city": {
              "type": "string"
            },
            "state": {
              "type": "string"
            }
          }
        },
        "segment": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "description"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "primary",
        "background",
        "text",
        "radius"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontFamily": {
          "enum": [
            "sans",
            "serif"
          ]
        }
      }
    },
    "whatsapp": {
      "type": "object",
      "required": [
        "phoneE164",
        "demoMode",
        "checkoutTemplateId",
        "quoteTemplateId",
        "supportTemplateId"
      ],
      "properties": {
        "phoneE164": {
          "type": "string",
          "pattern": "^[0-9]{10,15}$"
        },
        "demoMode": {
          "type": "boolean"
        },
        "defaultTemplateId": {
          "type": "string"
        },
        "recipientLabel": {
          "type": "string"
        },
        "checkoutTemplateId": {
          "type": "string"
        },
        "quoteTemplateId": {
          "type": "string"
        },
        "supportTemplateId": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "categoryId",
          "priceCents",
          "stock",
          "media"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "whatsappTemplateId": {
            "type": "string"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "assetId"
              ],
              "properties": {
                "assetId": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "needs_asset",
                    "ready"
                  ]
                }
              }
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "optionId",
                "sku",
                "label",
                "priceCents",
                "stock"
              ],
              "properties": {
                "optionId": {
                  "type": "string"
                },
                "sku": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "priceCents": {
                  "type": "integer",
                  "minimum": 0
                },
                "stock": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "genes": {
            "type": "object"
          },
          "responsive": {
            "type": "object",
            "properties": {
              "390": {
                "type": "object"
              },
              "768": {
                "type": "object"
              },
              "1024": {
                "type": "object"
              },
              "1440": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "kind",
          "ownerRef",
          "ratio",
          "status"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "ownerRef": {
            "type": "string"
          },
          "ratio": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$"
          },
          "status": {
            "enum": [
              "needs_asset",
              "ready"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "slot": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "header",
                  "hero",
                  "features",
                  "categoryTiles",
                  "catalog",
                  "cart",
                  "footer",
                  "story",
                  "faq",
                  "testimonials",
                  "announcement",
                  "contact",
                  "kitBuilder",
                  "booking",
                  "recommendations"
                ]
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "assetId": {
                "type": "string"
              },
              "cta": {
                "type": "string"
              },
              "genes": {
                "type": "object",
                "additionalProperties": true
              },
              "responsive": {
                "type": "object",
                "properties": {
                  "390": {
                    "type": "object"
                  },
                  "768": {
                    "type": "object"
                  },
                  "1024": {
                    "type": "object"
                  },
                  "1440": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              },
              "variant": {
                "type": "string"
              },
              "eyebrow": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "title",
                    "body"
                  ],
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    },
                    "author": {
                      "type": "string"
                    }
                  }
                }
              },
              "pet": {
                "type": "object",
                "required": [
                  "name",
                  "species",
                  "age",
                  "size",
                  "assetId"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "species": {
                    "type": "string"
                  },
                  "age": {
                    "type": "string"
                  },
                  "size": {
                    "type": "string"
                  },
                  "assetId": {
                    "type": "string"
                  }
                }
              },
              "kit": {
                "type": "object",
                "required": [
                  "slots"
                ],
                "properties": {
                  "slots": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label",
                        "categoryId",
                        "productSkus"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "label": {
                          "type": "string"
                        },
                        "categoryId": {
                          "type": "string"
                        },
                        "productSkus": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "defaultSku": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "booking": {
                "type": "object",
                "required": [
                  "dateOptions",
                  "timeOptions",
                  "templateId"
                ],
                "properties": {
                  "dateOptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeOptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "templateId": {
                    "type": "string"
                  }
                }
              },
              "productSkus": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "navItems": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "target"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "required": [
        "templates"
      ],
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "required": [
        "currency",
        "quantityStep",
        "checkoutMode"
      ],
      "properties": {
        "currency": {
          "const": "BRL"
        },
        "quantityStep": {
          "type": "integer",
          "minimum": 1
        },
        "maxPerItem": {
          "type": "integer",
          "minimum": 1
        },
        "checkoutMode": {
          "enum": [
            "whatsapp_link",
            "whatsapp_quote"
          ]
        },
        "shippingCents": {
          "type": "integer",
          "minimum": 0
        },
        "discountCents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets"
      ],
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId",
              "width",
              "height",
              "text",
              "negative"
            ],
            "properties": {
              "assetId": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 20
              },
              "negative": {
                "type": "string",
                "minLength": 10
              },
              "generationScope": {
                "enum": [
                  "full_scene",
                  "cutout",
                  "official_upload"
                ]
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sourceUrl",
                    "license",
                    "usage"
                  ],
                  "properties": {
                    "sourceUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "license": {
                      "type": "string"
                    },
                    "usage": {
                      "const": "reference_only"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
