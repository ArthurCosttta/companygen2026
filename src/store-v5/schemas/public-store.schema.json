{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof.local/schemas/public-store.json",
  "title": "SOF Genome Studio Public Store IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "business",
    "theme",
    "catalog",
    "assets",
    "screens",
    "overlays",
    "messages",
    "whatsapp",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "address"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tagline": { "type": "string" },
        "segment": { "type": "string" },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "state"],
          "properties": {
            "city": { "type": "string" },
            "state": { "type": "string" }
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "object" },
        "primary": { "type": "string" },
        "accent": { "type": "string" },
        "background": { "type": "string" },
        "text": { "type": "string" },
        "radius": { "type": "number" },
        "fontFamily": { "type": "string" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "products"],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "assetId": { "type": "string" }
            }
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sku", "slug", "name", "categoryId", "priceCents", "stock"],
            "properties": {
              "sku": { "type": "string" },
              "slug": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "categoryId": { "type": "string" },
              "priceCents": { "type": "integer", "minimum": 0 },
              "stock": { "type": "integer", "minimum": 0 },
              "media": { "type": "array", "items": { "type": "string" } },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["optionId", "label"],
                  "properties": {
                    "optionId": { "type": "string" },
                    "label": { "type": "string" },
                    "sku": { "type": "string" },
                    "priceCents": { "type": "integer" },
                    "stock": { "type": "integer" }
                  }
                }
              },
              "attributes": { "type": "object" },
              "genes": { "type": "object" }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "role", "url", "alt"],
        "properties": {
          "assetId": { "type": "string" },
          "role": {
            "enum": [
              "product_cutout",
              "portrait",
              "icon",
              "full_scene",
              "decorative",
              "category_tile",
              "brand_logo",
              "service_photo"
            ]
          },
          "url": {
            "type": "string",
            "not": { "pattern": "^data:image" }
          },
          "width": { "type": "integer" },
          "height": { "type": "integer" },
          "alt": { "type": "string", "minLength": 1 },
          "ratio": { "type": "string" },
          "focalPoint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "safeArea": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "mobileAssetRef": { "type": "string" }
        }
      }
    },
    "screens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "product"],
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "sections"],
          "properties": {
            "route": { "const": "/" },
            "sections": { "type": "array" }
          }
        },
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route", "proteinId"],
          "properties": {
            "route": { "const": "/produto/:slug" },
            "proteinId": { "const": "ProductDetail" }
          }
        }
      }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cart", "search"],
      "properties": {
        "cart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proteinId", "maxWidthPx", "maxHeightDvh", "steps"],
          "properties": {
            "proteinId": { "const": "CartDialog" },
            "maxWidthPx": { "type": "number", "maximum": 640 },
            "maxHeightDvh": { "type": "number", "maximum": 90 },
            "steps": {
              "type": "array",
              "items": { "enum": ["cart", "review"] }
            }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proteinId", "debounceMs", "maxResults"],
          "properties": {
            "proteinId": { "const": "SearchResults" },
            "debounceMs": { "type": "number", "minimum": 100, "maximum": 250 },
            "maxResults": { "type": "integer", "minimum": 1, "maximum": 20 }
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates"],
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "whatsapp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phoneE164", "checkoutTemplateId"],
      "properties": {
        "phoneE164": {
          "type": "string",
          "pattern": "^[1-9][0-9]{9,14}$"
        },
        "checkoutTemplateId": { "type": "string" },
        "defaultTemplateId": { "type": "string" },
        "quoteTemplateId": { "type": "string" },
        "supportTemplateId": { "type": "string" }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "quantityStep", "maxPerItem", "checkoutMode"],
      "properties": {
        "currency": { "type": "string" },
        "quantityStep": { "type": "integer", "minimum": 1 },
        "maxPerItem": { "type": "integer", "minimum": 1 },
        "checkoutMode": { "type": "string" },
        "shippingCents": { "type": "integer" },
        "discountCents": { "type": "integer" }
      }
    }
  }
}
